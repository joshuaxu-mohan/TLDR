# Copy to .env and fill in. Never commit real values.

# Required by the web API: bearer token for every non-GET request under /api.
# The frontend build must carry the same value as VITE_API_TOKEN
# (deploy/deploy.sh injects it from this file on the VM).
API_BEARER_TOKEN=

# Summarisation (Gemini) and transcription (Groq)
GEMINI_API_KEY=
GROQ_API_KEY=

# Podcast discovery (Taddy)
TADDY_USER_ID=
TADDY_API_KEY=

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp delivery via Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
MY_WHATSAPP_NUMBER=

# Spotify export script (optional)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional overrides (defaults shown)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# DB_PATH=./data/digest.db
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
